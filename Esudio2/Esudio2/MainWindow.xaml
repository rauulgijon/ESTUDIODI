<Window x:Class="Esudio2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewer="clr-namespace:SAPBusinessObjects.WPF.Viewer;assembly=SAPBusinessObjects.WPF.Viewer"
        Title="MotorFast - Módulo de Facturación" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#E0E0E0" VerticalAlignment="Stretch">
            <Label Content="Introduce el ID del Cliente:" 
                   VerticalAlignment="Center" 
                   Margin="20,0,10,0" 
                   FontWeight="Bold" FontSize="14"/>

            <TextBox x:Name="txtIdCliente" 
                     Width="120" Height="25" 
                     VerticalAlignment="Center" 
                     FontSize="14" 
                     VerticalContentAlignment="Center"/>

            <Button x:Name="btnGenerarFactura" 
                    Content="Generar Factura" 
                    Width="140" Height="35" 
                    Margin="20,0,0,0" 
                    Background="#2196F3" Foreground="White" FontWeight="Bold"
                    Click="btnGenerarFactura_Click"/>
        </StackPanel>

        <viewer:CrystalReportsViewer x:Name="crViewer" Grid.Row="1" Margin="5"/>
    </Grid>
</Window>