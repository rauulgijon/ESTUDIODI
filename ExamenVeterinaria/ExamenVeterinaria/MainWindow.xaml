<Window x:Class="ExamenVeterinaria.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewer="clr-namespace:SAPBusinessObjects.WPF.Viewer;assembly=SAPBusinessObjects.WPF.Viewer"
        Title="Clínica Veterinaria - Historial Clínico" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#4CAF50" VerticalAlignment="Stretch">
            <Label Content="ID de la Mascota:" VerticalAlignment="Center" Margin="20,0,10,0" Foreground="White" FontWeight="Bold" FontSize="14"/>
            <TextBox x:Name="txtIdMascota" Width="100" Height="25" VerticalAlignment="Center" FontSize="14" VerticalContentAlignment="Center"/>
            <Button x:Name="btnGenerarHistorial" Content="Generar Historial" Width="140" Height="35" Margin="20,0,0,0" Background="White" FontWeight="Bold" Click="btnGenerarHistorial_Click"/>
        </StackPanel>

        <viewer:CrystalReportsViewer x:Name="crViewer" Grid.Row="1" Margin="5"/>
    </Grid>
</Window>