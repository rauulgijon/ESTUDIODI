<Window x:Class="IronFit.MainWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IronFit"
        mc:Ignorable="d"
        Title="Reservation Management System" Height="1000" Width="1800" Loaded="Window_Loaded">
    <Grid>
        <TabControl>
            <TabItem Header="Gestion">
                
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"></ColumnDefinition>
                        <ColumnDefinition Width="1*"></ColumnDefinition>
                        <ColumnDefinition Width="1*"></ColumnDefinition>
                        <ColumnDefinition Width="1*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.2*"></RowDefinition>
                        <RowDefinition Height="1*"></RowDefinition>
                        <RowDefinition Height="1*"></RowDefinition>
                        <RowDefinition Height="1*"></RowDefinition>
                        <RowDefinition Height="1*"></RowDefinition>
                        <RowDefinition Height="1*"></RowDefinition>
                        <RowDefinition Height="1*"></RowDefinition>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" FontSize="16" FontWeight="Bold">Socios</Label>
                    <DataGrid Grid.RowSpan="3" Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="0" Margin="5" x:Name="dgGuests" AutoGenerateColumns="False" SelectionChanged="dgSocios_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding IdSocio}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Dni" Binding="{Binding Dni}" Width="*"/>

                            <DataGridTextColumn Header="Cuota Mensual" Binding="{Binding CuotaMensual}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Label Grid.Row="0" Grid.Column="2" FontSize="16" FontWeight="Bold">Clases Extra</Label>
                    <DataGrid Grid.RowSpan="3" Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="2" Margin="5" x:Name="dgParcels" AutoGenerateColumns="False" SelectionChanged="dgClases_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Id Clase" Binding="{Binding IdClase}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Id Socio" Binding="{Binding IdSocio}" Width="*"/>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="*"/>
                            <DataGridTextColumn Header="Nombre Clase" Binding="{Binding NombreClase}" Width="*"/>
                            <DataGridTextColumn Header="Coste" Binding="{Binding Coste}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Margin="5" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="3" BorderThickness="2" BorderBrush="HotPink">
                        <StackPanel Margin="10">
                            <Label FontSize="14" FontWeight="Bold" Foreground="HotPink">Gestor Socios</Label>
                            <Label FontSize="12">ID</Label>
                            <TextBox x:Name="txtIdSocio" IsReadOnly="True" Background="#EEE"/>
                            <Label FontSize="12">Nombre</Label>
                            <TextBox x:Name="txtNombre"/>
                            <Label FontSize="12">Dni</Label>
                            <TextBox x:Name="txtDni"/>
                            <Label FontSize="12">Couta Mensual</Label>
                            <TextBox x:Name="txtCuotaMensual"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Margin="5" Padding="10" Click="btnSocioAdd_Click">Add</Button>
                                <Button Margin="5" Padding="10" Click="btnSocioUpdate_Click">Update</Button>
                                <Button Margin="5" Padding="10" Click="btnSocioDelete_Click">Delete</Button>
                                <Button Margin="5" Padding="10" Click="btnSocioClear_Click">Clear</Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Margin="5" Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" Grid.RowSpan="3" BorderThickness="2" BorderBrush="Cyan">
                        <StackPanel Margin="10">
                            <Label FontSize="14" FontWeight="Bold" Foreground="DarkCyan">Parcel Management</Label>
                            <Label FontSize="12">Id Clase</Label>
                            <TextBox x:Name="txtIdClase" IsReadOnly="True" Background="#EEE"/>
                            <Label FontSize="12">Id Socio</Label>
                            <TextBox x:Name="txtIdSocioClase"/>
                            <Label FontSize="12">Fecha</Label>
                            <DatePicker Name="DatePickerFecha"/>
                            <Label FontSize="12">Nombre de la Clase</Label>
                            <TextBox x:Name="txtNombreClase"/>
                            <Label FontSize="12">Coste</Label>
                            <TextBox x:Name="txtCoste"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Margin="5" Padding="10" Click="btnClaseExtraAdd_Click">Add</Button>
                                <Button Margin="5" Padding="10" Click="btnClaseExtraUpdate_Click">Update</Button>
                                <Button Margin="5" Padding="10" Click="btnClaseExtraDelete_Click">Delete</Button>
                                <Button Margin="5" Padding="10" Click="btnClaseExtraClear_Click">Clear</Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Informe" xmlns:cr="clr-namespace:SAPBusinessObjects.WPF.Viewer;assembly=SAPBusinessObjects.WPF.Viewer">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#E0E0E0" VerticalAlignment="Stretch">
                        <Label Content="Introduce el ID del Socio:" 
               VerticalAlignment="Center" 
               Margin="20,0,10,0" 
               FontWeight="Bold" FontSize="14"/>

                        <TextBox x:Name="txtidSocio" 
                 Width="120" Height="25" 
                 VerticalAlignment="Center" 
                 FontSize="14" 
                 VerticalContentAlignment="Center"/>

                        <Button x:Name="btnGenerarFactura" 
                Content="Generar Factura" 
                Width="140" Height="35" 
                Margin="20,0,0,0" 
                Background="#2196F3" Foreground="White" FontWeight="Bold"
                Click="btnGenerarFactura_Click"/>
                    </StackPanel>

                    <cr:CrystalReportsViewer x:Name="crViewer" Grid.Row="1" Margin="5"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>