<Window x:Class="WPF_LoginForm.View.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_LoginForm.View"
        mc:Ignorable="d"
        Title="Sistema de Gestión - TalentLab"
        Height="480" Width="860"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBlue"    Color="#1F5B96"/>
        <SolidColorBrush x:Key="SecondaryGreen" Color="#2D8659"/>
        <SolidColorBrush x:Key="DarkGray"       Color="#3D4A5C"/>
        <SolidColorBrush x:Key="BorderGray"     Color="#E0E3E8"/>

        <Style x:Key="LoginButton" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource SecondaryGreen}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#245D4B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WinButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#B8D4E8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D4A6E"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Height"              Value="34"/>
            <Setter Property="FontSize"            Value="13"/>
            <Setter Property="Padding"             Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush"         Value="{StaticResource BorderGray}"/>
            <Setter Property="BorderThickness"     Value="1"/>
            <Setter Property="Background"          Value="White"/>
        </Style>

        <Style x:Key="FieldPass" TargetType="PasswordBox">
            <Setter Property="Height"              Value="34"/>
            <Setter Property="FontSize"            Value="13"/>
            <Setter Property="Padding"             Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush"         Value="{StaticResource BorderGray}"/>
            <Setter Property="BorderThickness"     Value="1"/>
            <Setter Property="Background"          Value="White"/>
        </Style>
    </Window.Resources>

    <!-- Marco exterior con sombra suave -->
    <Border CornerRadius="10" Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Panel izquierdo: imagen de marca -->
                <ColumnDefinition Width="2.2*"/>
                <!-- Panel derecho: formulario -->
                <ColumnDefinition Width="1.8*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ PANEL IZQUIERDO ═══ -->
            <Border Grid.Column="0" CornerRadius="10,0,0,10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1F5B96" Offset="0"/>
                        <GradientStop Color="#163F6A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Barra de título / botones ventana -->
                    <Grid Grid.Row="0" HorizontalAlignment="Right" Margin="0,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="btnMinimize" Content="—"
                                Style="{StaticResource WinButton}"
                                Click="btnMinimize_Click"/>
                        <Button Grid.Column="1" x:Name="btnClose"    Content="✕"
                                Style="{StaticResource WinButton}"
                                Click="btnClose_Click">
                        </Button>
                    </Grid>

                    <!-- Contenido de marca -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Margin="30,0">
                        <TextBlock Text="¿ACEPTAS"
                                   Foreground="White" FontSize="34" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="EL RETO?"
                                   Foreground="#B8D4E8" FontSize="34" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,-6,0,0"/>
                        <Rectangle Height="2" Width="160" Fill="#2D8659" Margin="0,16,0,16"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Sistema de Gestión TalentLab"
                                   Foreground="#B8D4E8" FontSize="12"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ PANEL DERECHO: FORMULARIO ═══ -->
            <Border Grid.Column="1" CornerRadius="0,10,10,0" Background="#F5F6F8" Padding="36,0">
                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="INICIAR SESIÓN"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource DarkGray}"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="Introduce tu nombre y apellido para continuar."
                               FontSize="11" Foreground="#888"
                               TextWrapping="Wrap" Margin="0,0,0,24"/>

                    <!-- Nombre -->
                    <TextBlock Text="Nombre" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource DarkGray}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtUser" Style="{StaticResource FieldBox}" Margin="0,0,0,16"/>

                    <!-- Contraseña (apellido) -->
                    <TextBlock FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource DarkGray}" Margin="0,0,0,4">
                        <Run Text="Contraseña"/>
                        <Run Text=" (es tu apellido)" Foreground="#999" FontWeight="Normal"/>
                    </TextBlock>
                    <PasswordBox x:Name="txtPass" Style="{StaticResource FieldPass}" Margin="0,0,0,28"/>

                    <!-- Botón Login -->
                    <Button x:Name="btnLogin" Content="ENTRAR"
                            Style="{StaticResource LoginButton}"
                            Height="40" Padding="0"
                            Click="btnLogin_Click"/>

                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>
