<Window x:Class="ExamenManuelDI2Recuperacion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExamenManuelDI2Recuperacion"
        mc:Ignorable="d"
        Title="Reservation Management System" Height="1000" Width="1800" Loaded="Window_Loaded">
    <Grid>
        <TabControl>
            <TabItem Header="Management">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"></ColumnDefinition>
                        <ColumnDefinition Width="1*"></ColumnDefinition>
                        <ColumnDefinition Width="1*"></ColumnDefinition>
                        <ColumnDefinition Width="1*"></ColumnDefinition>
                        <ColumnDefinition Width="1*"></ColumnDefinition>
                        <ColumnDefinition Width="1*"></ColumnDefinition>
                        <ColumnDefinition Width="1*"></ColumnDefinition>
                        <ColumnDefinition Width="1*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.2*"></RowDefinition>
                        <RowDefinition Height="1*"></RowDefinition>
                        <RowDefinition Height="1*"></RowDefinition>
                        <RowDefinition Height="1*"></RowDefinition>
                        <RowDefinition Height="1*"></RowDefinition>
                        <RowDefinition Height="1*"></RowDefinition>
                        <RowDefinition Height="1*"></RowDefinition>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" FontSize="16" FontWeight="Bold">Guests</Label>
                    <DataGrid Grid.RowSpan="3" Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="0" Margin="5" x:Name="dgGuests" AutoGenerateColumns="False" SelectionChanged="dgGuests_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding IdGuest}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Passport" Binding="{Binding Passport}" Width="*"/>
                            <DataGridTextColumn Header="Telephone" Binding="{Binding Telephone}" Width="*"/>
                            <DataGridTextColumn Header="Vehicle ID" Binding="{Binding VehicleId}" Width="*"/>
                            <DataGridTextColumn Header="License Plate" Binding="{Binding LicencePlate}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Label Grid.Row="0" Grid.Column="2" FontSize="16" FontWeight="Bold">Parcels</Label>
                    <DataGrid Grid.RowSpan="3" Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="2" Margin="5" x:Name="dgParcels" AutoGenerateColumns="False" SelectionChanged="dgParcels_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding IdParcel}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding ParcelSize}" Width="*"/>
                            <DataGridTextColumn Header="Light" Binding="{Binding Light}" Width="*"/>
                            <DataGridTextColumn Header="Water" Binding="{Binding Water}" Width="*"/>
                            <DataGridTextColumn Header="Price/Col" Binding="{Binding Parcelcol}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Label Grid.Row="0" Grid.Column="4" FontSize="16" FontWeight="Bold">Reservations</Label>
                    <DataGrid Grid.RowSpan="3" Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="4" Margin="5" x:Name="dgReservations" AutoGenerateColumns="False" SelectionChanged="dgReservations_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding IdReservation}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Guest ID" Binding="{Binding GuestId}" Width="*"/>
                            <DataGridTextColumn Header="Parcel ID" Binding="{Binding ParcelId}" Width="*"/>
                            <DataGridTextColumn Header="CheckIn" Binding="{Binding CheckInDate}" Width="*"/>
                            <DataGridTextColumn Header="CheckOut" Binding="{Binding CheckOutDate}" Width="*"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalCost}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Label Grid.Row="0" Grid.Column="6" FontSize="16" FontWeight="Bold">Vehicle Types</Label>
                    <DataGrid Margin="5" Grid.Row="1" Grid.RowSpan="3" Grid.ColumnSpan="2" Grid.Column="6" x:Name="dgVehicleTypes" AutoGenerateColumns="False" SelectionChanged="dgVehicleTypes_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding IdVehicleType}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Margin="5" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="3" BorderThickness="2" BorderBrush="HotPink">
                        <StackPanel Margin="10">
                            <Label FontSize="14" FontWeight="Bold" Foreground="HotPink">Guest Management</Label>
                            <Label FontSize="12">ID</Label>
                            <TextBox x:Name="txtGuestId" IsReadOnly="True" Background="#EEE"/>
                            <Label FontSize="12">Name</Label>
                            <TextBox x:Name="txtGuestName"/>
                            <Label FontSize="12">Passport</Label>
                            <TextBox x:Name="txtGuestPassport"/>
                            <Label FontSize="12">Telephone</Label>
                            <TextBox x:Name="txtGuestTelephone"/>
                            <Label FontSize="12">Vehicle ID</Label>
                            <TextBox x:Name="txtGuestVehicleId"/>
                            <Label FontSize="12">License Plate</Label>
                            <TextBox x:Name="txtGuestLicensePlate"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Margin="5" Padding="10" Click="btnGuestAdd_Click">Add</Button>
                                <Button Margin="5" Padding="10" Click="btnGuestUpdate_Click">Update</Button>
                                <Button Margin="5" Padding="10" Click="btnGuestDelete_Click">Delete</Button>
                                <Button Margin="5" Padding="10" Click="btnGuestClear_Click">Clear</Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Margin="5" Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" Grid.RowSpan="3" BorderThickness="2" BorderBrush="Cyan">
                        <StackPanel Margin="10">
                            <Label FontSize="14" FontWeight="Bold" Foreground="DarkCyan">Parcel Management</Label>
                            <Label FontSize="12">ID</Label>
                            <TextBox x:Name="txtParcelId" IsReadOnly="True" Background="#EEE"/>
                            <Label FontSize="12">Size (e.g. Small, Large)</Label>
                            <TextBox x:Name="txtParcelSize"/>
                            <Label FontSize="12">Parcel Price (Price/Float)</Label>
                            <TextBox x:Name="txtParcelCol"/>
                            <CheckBox x:Name="chkParcelLight" Margin="0,10,0,5">Has Light</CheckBox>
                            <CheckBox x:Name="chkParcelWater" Margin="0,5,0,10">Has Water</CheckBox>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Margin="5" Padding="10" Click="btnParcelAdd_Click">Add</Button>
                                <Button Margin="5" Padding="10" Click="btnParcelUpdate_Click">Update</Button>
                                <Button Margin="5" Padding="10" Click="btnParcelDelete_Click">Delete</Button>
                                <Button Margin="5" Padding="10" Click="btnParcelClear_Click">Clear</Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Margin="5" Grid.Row="4" Grid.Column="4" Grid.ColumnSpan="2" Grid.RowSpan="3" BorderThickness="2" BorderBrush="Red">
                        <StackPanel Margin="10">
                            <Label FontSize="14" FontWeight="Bold" Foreground="Red">Reservation Management</Label>
                            <Label FontSize="12">ID</Label>
                            <TextBox x:Name="txtResId" IsReadOnly="True" Background="#EEE"/>
                            <Label FontSize="12">Guest ID</Label>
                            <TextBox x:Name="txtResGuestId"/>
                            <Label FontSize="12">Parcel ID</Label>
                            <TextBox x:Name="txtResParcelId"/>
                            <Label FontSize="12">Check-In Date</Label>
                            <DatePicker x:Name="dpResCheckIn" SelectedDateFormat="Short"/>
                            <Label FontSize="12">Check-Out Date</Label>
                            <DatePicker x:Name="dpResCheckOut" SelectedDateFormat="Short"/>
                            <Label FontSize="12">Total Cost</Label>
                            <TextBox x:Name="txtResTotalCost"/>
                            <Label FontSize="12">Status</Label>
                            <TextBox x:Name="txtResStatus"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Margin="5" Padding="10" Click="btnResAdd_Click">Add</Button>
                                <Button Margin="5" Padding="10" Click="btnResUpdate_Click">Update</Button>
                                <Button Margin="5" Padding="10" Click="btnResDelete_Click">Delete</Button>
                                <Button Margin="5" Padding="10" Click="btnResClear_Click">Clear</Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Margin="5" Grid.Row="4" Grid.Column="6" Grid.ColumnSpan="2" Grid.RowSpan="3" BorderThickness="2" BorderBrush="Orange">
                        <StackPanel Margin="10">
                            <Label FontSize="14" FontWeight="Bold" Foreground="Orange">Vehicle Types</Label>
                            <Label FontSize="12">ID</Label>
                            <TextBox x:Name="txtVehId" IsReadOnly="True" Background="#EEE"/>
                            <Label FontSize="12">Vehicle Type</Label>
                            <TextBox x:Name="txtVehType"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Margin="5" Padding="10" Click="btnVehAdd_Click">Add</Button>
                                <Button Margin="5" Padding="10" Click="btnVehUpdate_Click">Update</Button>
                                <Button Margin="5" Padding="10" Click="btnVehDelete_Click">Delete</Button>
                                <Button Margin="5" Padding="10" Click="btnVehClear_Click">Clear</Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Reports" xmlns:cr="clr-namespace:SAPBusinessObjects.WPF.Viewer;assembly=SAPBusinessObjects.WPF.Viewer">
                <Grid Background="White">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="49.119"/>
                        <ColumnDefinition Width="150.881"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" BorderThickness="2" BorderBrush="Gray" Margin="5,5,5,5" Grid.ColumnSpan="2">
                        <StackPanel Margin="10">
                            <Label FontSize="14" FontWeight="Bold">Select Report</Label>
                            <Separator Margin="0,5"/>

                            <Label FontSize="12" FontWeight="Bold">Report Type:</Label>

                            <RadioButton x:Name="rbReservasMes" Margin="5" IsChecked="True">
                                <TextBlock FontSize="11">1. Reservations by month</TextBlock>
                            </RadioButton>
                            <TextBlock FontSize="10" Foreground="Gray" Margin="25,0,5,10">Reservations for each month</TextBlock>

                            <RadioButton x:Name="rbReporteFinanciero" Margin="5">
                                <TextBlock FontSize="11">2. Finantial Report</TextBlock>
                            </RadioButton>
                            <TextBlock FontSize="10" Foreground="Gray" Margin="25,0,5,10">Total finantial benefits</TextBlock>

                            <Separator Margin="0,10"/>

                            <Button x:Name="btnGenerateReport" Click="GenerateReport" Padding="10" Margin="5" Background="DodgerBlue" Foreground="White" FontWeight="Bold">
                                Generate Report
                            </Button>
                        </StackPanel>
                    </Border>

                    <cr:CrystalReportsViewer x:Name="crViewer" 
                                 Grid.Column="2" 
                                 Grid.Row="0" 
                                 Grid.RowSpan="4" 
                                 Margin="5" 
                                 ShowLogo="False"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>